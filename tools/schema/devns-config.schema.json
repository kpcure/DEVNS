{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devns.dev/schemas/devns-config.schema.json",
  "title": "DEVNS Configuration",
  "type": "object",
  "required": ["version", "features"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "number" },
    "features": { "type": "string" },
    "candidates": { "type": "string" },
    "rfcs": { "type": "string" },
    "history": { "type": "string" },
    "traces": { "type": "string" },
    "policies": { "type": "string" },
    "artifactIntegrity": {
      "type": "object",
      "properties": {
        "browserSmoke": {
          "type": "object",
          "properties": {
            "requireRichBrowserArtifacts": { "type": "boolean" },
            "failOnConsoleError": { "type": "boolean" },
            "consoleErrorBudget": { "type": "number", "minimum": 0 },
            "failOnNetworkError": { "type": "boolean" },
            "networkFailureBudget": { "type": "number", "minimum": 0 },
            "networkFailureStatus": { "type": "number", "minimum": 100, "maximum": 599 },
            "networkAllowedUrls": {
              "type": "array",
              "items": { "type": "string" }
            },
            "networkBlockedUrls": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "completionPolicy": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["queue"]
        },
        "whenNoActiveFeature": {
          "type": "string",
          "enum": ["claim_next", "allow_stop"]
        },
        "whenNoClaimableFeature": {
          "type": "string",
          "enum": ["allow_stop", "stop_for_human_review"]
        },
        "requireApprovedRfc": { "type": "boolean" },
        "requireEvidence": { "type": "boolean" },
        "requireReviewDecision": { "type": "boolean" },
        "requireCleanWorktree": { "type": "boolean" },
        "requireCommit": { "type": "boolean" },
        "allowEmptyOutputWhenComplete": { "type": "boolean" },
        "contextBudget": {
          "type": "object",
          "properties": {
            "maxContinuationTurns": { "type": "number" },
            "preferFreshWorkerPerFeature": { "type": "boolean" },
            "handoffTokenBudget": { "type": "number" },
            "resetWhenHistoryRecordsExceed": { "type": "number" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["html"]
        },
        "outputDir": { "type": "string" }
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "object",
      "properties": {
        "init": { "type": "string" },
        "rfc": { "type": "string" },
        "run": { "type": "string" }
      },
      "additionalProperties": { "type": "string" }
    },
    "hooks": {
      "type": "object",
      "properties": {
        "stop": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["gate"]
            },
            "retryBudget": { "type": "number" },
            "defaultDecision": {
              "type": "string",
              "enum": ["stop_for_human_review"]
            },
            "blockOn": {
              "type": "object",
              "additionalProperties": { "type": "boolean" }
            },
            "reviewAgent": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": ["off", "run_missing"]
                },
                "laneIds": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "requireDeterministicEvidence": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "type": "object",
      "additionalProperties": true
    },
    "sensors": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "reviewLanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["command", "agent", "builtin"]
          },
          "command": { "type": "string" },
          "agent": { "type": "string" },
          "required": { "type": "boolean" },
          "blocksCompletion": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "theme": { "type": "string" },
        "panels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "slot", "renderer"],
            "properties": {
              "id": { "type": "string" },
              "slot": { "type": "string" },
              "renderer": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "properties": {
        "skills": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "agents": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "policies": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "lanes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "sensors": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
