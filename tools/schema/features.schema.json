{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://never-stop.dev/schemas/features.schema.json",
  "title": "Never Stop Feature Inventory",
  "type": "object",
  "required": ["project", "features"],
  "properties": {
    "$schema": { "type": "string" },
    "revision": { "type": "string" },
    "project": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "repository": { "type": "string" }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "status", "priority", "milestone", "acceptanceCriteria"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["ready", "in_progress", "done", "blocked", "failed"]
          },
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "milestone": { "type": "string" },
          "risk": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "context": {
            "type": "array",
            "items": { "type": "string" }
          },
          "acceptanceCriteria": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "verification": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "summary"],
              "properties": {
                "type": { "type": "string" },
                "summary": { "type": "string" },
                "url": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "changedFiles": {
            "type": "array",
            "items": { "type": "string" }
          },
          "history": {
            "type": "object",
            "properties": {
              "latestRecord": { "type": "string" },
              "latestSummary": { "type": "string" },
              "recordCount": { "type": "number" },
              "historyPath": { "type": "string" }
            },
            "additionalProperties": false
          },
          "commit": { "type": "string" },
          "review": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              },
              "summary": { "type": "string" },
              "risks": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          },
          "reviewDecision": {
            "type": "string",
            "enum": ["pending", "approved", "needs_changes", "follow_up"]
          },
          "agentNotes": { "type": "string" },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "at", "summary"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["claimed", "released", "blocked", "failed", "completed"]
                },
                "at": { "type": "string" },
                "by": { "type": "string" },
                "summary": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "rfc": {
            "type": "object",
            "required": [
              "status",
              "summary",
              "background",
              "featureDescription",
              "expectedOutcome",
              "goals",
              "nonGoals",
              "requirements",
              "acceptanceCriteria",
              "validationPlan",
              "testCases"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["draft", "needs_human_review", "approved", "needs_changes", "blocked", "superseded"]
              },
              "summary": { "type": "string" },
              "background": { "type": "string" },
              "featureDescription": { "type": "string" },
              "expectedOutcome": { "type": "string" },
              "goals": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              },
              "nonGoals": {
                "type": "array",
                "items": { "type": "string" }
              },
              "requirements": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "type", "statement", "priority"],
                  "properties": {
                    "id": { "type": "string" },
                    "type": {
                      "type": "string",
                      "enum": ["explicit", "implicit"]
                    },
                    "statement": { "type": "string" },
                    "source": { "type": "string" },
                    "priority": {
                      "type": "string",
                      "enum": ["must", "should", "could"]
                    }
                  },
                  "additionalProperties": false
                }
              },
              "acceptanceCriteria": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "statement"],
                  "properties": {
                    "id": { "type": "string" },
                    "requirementIds": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "statement": { "type": "string" },
                    "verification": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "validationPlan": {
                "type": "object",
                "required": ["dynamic", "static"],
                "properties": {
                  "dynamic": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "static": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                },
                "additionalProperties": false
              },
              "testCases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "type", "scenario", "expected"],
                  "properties": {
                    "id": { "type": "string" },
                    "acceptanceCriteriaIds": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "type": {
                      "type": "string",
                      "enum": ["unit", "integration", "e2e", "static", "manual"]
                    },
                    "scenario": { "type": "string" },
                    "expected": { "type": "string" },
                    "candidateTestName": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "unknowns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["question", "severity"],
                  "properties": {
                    "question": { "type": "string" },
                    "severity": {
                      "type": "string",
                      "enum": ["blocking", "non_blocking"]
                    },
                    "owner": {
                      "type": "string",
                      "enum": ["human", "agent"]
                    }
                  },
                  "additionalProperties": false
                }
              },
              "risks": {
                "type": "array",
                "items": { "type": "string" }
              },
              "humanDecision": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["pending", "approved", "needs_changes", "rejected"]
                  },
                  "decidedBy": { "type": "string" },
                  "decidedAt": { "type": "string" },
                  "notes": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "area", "severity", "options", "recommended"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "area": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "options": {
            "type": "array",
            "items": { "type": "string" }
          },
          "recommended": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["open", "resolved", "deferred"]
          }
        },
        "additionalProperties": false
      }
    },
    "researchSources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "url", "takeaway"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "takeaway": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
