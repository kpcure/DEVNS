{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devns.dev/schemas/eval-case.schema.json",
  "title": "DEVNS Eval Case",
  "type": "object",
  "required": ["id", "tier", "mode", "generality_level", "given", "action", "expect"],
  "properties": {
    "id": { "type": "string" },
    "tier": { "type": "string", "enum": ["t1", "t2", "t3"] },
    "mode": { "type": "string" },
    "generality_level": { "type": "string", "enum": ["distribution", "task", "domain", "general"] },
    "given": { "type": "object" },
    "action": {
      "type": "object",
      "required": ["gate"],
      "properties": {
        "gate": {
          "type": "string",
          "enum": [
            "completion_independent_review",
            "candidate_provenance",
            "scope_guard",
            "evidence_quality",
            "artifact_integrity",
            "artifact_digest",
            "dashboard_artifact_preview",
            "review_lane_result",
            "review_calibration_result",
            "review_adapter_execution",
            "review_packet_quality",
            "context_budget",
            "project_extension_config",
            "host_adapter_init",
            "stop_hook_review_agent",
            "seed_repository",
            "orchestrator_trace",
            "state_atomic_write"
          ]
        },
        "cmd": { "type": "string" },
        "args": { "type": "object" }
      },
      "additionalProperties": false
    },
    "expect": {
      "type": "object",
      "required": ["decision"],
      "properties": {
        "decision": { "type": "string", "enum": ["allowed", "blocked"] },
        "reasonContains": { "type": "string" },
        "laneDecision": { "type": "string", "enum": ["allow", "warn", "block", "needs_human_review"] },
        "requiredFindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/findingExpectation" }
        },
        "forbiddenFindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/findingExpectation" }
        },
        "minScores": {
          "type": "object",
          "properties": {
            "correctness": { "type": "number", "minimum": 0, "maximum": 1 },
            "requirementCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
            "scope": { "type": "number", "minimum": 0, "maximum": 1 },
            "security": { "type": "number", "minimum": 0, "maximum": 1 },
            "test": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        "maxErrorFindings": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "findingExpectation": {
      "type": "object",
      "properties": {
        "severity": { "type": "string", "enum": ["info", "warning", "error"] },
        "category": {
          "type": "string",
          "enum": ["correctness", "security", "scope", "test", "maintainability", "reviewability"]
        },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
        "file": { "type": "string" },
        "line": { "type": "number" },
        "messageContains": { "type": "string" },
        "requirementIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidenceTypes": {
          "type": "array",
          "items": { "type": "string", "enum": ["diff", "command", "artifact", "requirement", "source"] }
        },
        "blocksCompletion": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
