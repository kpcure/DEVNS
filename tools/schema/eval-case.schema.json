{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devns.dev/schemas/eval-case.schema.json",
  "title": "DEVNS Eval Case",
  "type": "object",
  "required": ["id", "tier", "mode", "generality_level", "given", "action", "expect"],
  "properties": {
    "id": { "type": "string" },
    "tier": { "type": "string", "enum": ["t1", "t2", "t3"] },
    "mode": { "type": "string" },
    "generality_level": { "type": "string", "enum": ["distribution", "task", "domain", "general"] },
    "given": { "type": "object" },
    "action": {
      "type": "object",
      "required": ["gate"],
      "properties": {
        "gate": {
          "type": "string",
          "enum": ["completion_independent_review", "candidate_provenance", "scope_guard"]
        },
        "cmd": { "type": "string" },
        "args": { "type": "object" }
      },
      "additionalProperties": false
    },
    "expect": {
      "type": "object",
      "required": ["decision"],
      "properties": {
        "decision": { "type": "string", "enum": ["allowed", "blocked"] },
        "reasonContains": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
