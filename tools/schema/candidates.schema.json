{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devns.dev/schemas/candidates.schema.json",
  "title": "DevNS Candidate Inventory",
  "type": "object",
  "required": ["candidates"],
  "properties": {
    "$schema": { "type": "string" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "description"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["discovered", "needs_rfc", "rejected", "promoted"]
          },
          "sources": {
            "type": "array",
            "items": { "type": "string" }
          },
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "suggestedPriority": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "suggestedMilestone": { "type": "string" },
          "unknowns": {
            "type": "array"
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
